<IfModule mod_rewrite.c>
    RewriteEngine On

    # Rutas de reescritura RELATIVAS (sin "/" inicial): funcionan igual si este
    # .htaccess vive en la raiz del DocumentRoot (vhost) o en una subcarpeta
    # compartida (http://localhost/<carpeta>/), porque tanto el patron como el
    # destino se resuelven relativos al directorio que contiene este archivo,
    # nunca al dominio.

    # 1) Assets estaticos compilados por Vite (JS, CSS, fuentes, imagenes) -> servir tal cual
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]

    # 2) Todo lo demas (API y paginas) -> front controller unico
    RewriteRule ^ public/index.php [L]
</IfModule>
