APP_ENV=local
APP_DEBUG=true
APP_KEY=changeme_generate_a_random_32_byte_string

# Ruta base de la app bajo el host (ej. /copiwaypro si abres http://localhost/copiwaypro/).
# Vacio = se autodetecta a partir de la ruta real del front controller (recomendado).
APP_BASE_PATH=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hamburguer_copiway
DB_USER=root
DB_PASS=

SESSION_NAME=copiway_session
SESSION_LIFETIME=120

RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15

# Notificaciones push (Web Push / VAPID) al cliente cuando su pedido llega.
# Genera tu propio par con: vendor/bin/... o php -r usando
# Minishlink\WebPush\VAPID::createVapidKeys() (ver composer.json). Cada
# instalacion (cada dominio) deberia tener su propio par, no reusar este.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@copiway.com

# En Windows, openssl_pkey_new() con curvas EC (lo que exige VAPID) falla si
# OPENSSL_CONF no apunta a un openssl.cnf real ANTES de que arranque PHP (un
# putenv() dentro del codigo ya es demasiado tarde). start.bat ya lo resuelve
# solo para el servidor embebido; si sirves con Apache/Laragon, define
# OPENSSL_CONF como variable de entorno de Windows (apuntando al openssl.cnf
# que trae tu PHP, ej. C:\laragon\bin\php\php-x.y.z\extras\ssl\openssl.cnf) y
# reinicia Apache -- si no, las notificaciones push simplemente no se envian.

# Solo para "npm run dev" (Vite): a donde reenviar /api/* mientras desarrollas.
# Por defecto el servidor embebido de PHP (start.bat). Si usas Apache en una
# subcarpeta, cambialo por ejemplo a http://localhost/copiwaypro
VITE_API_PROXY_TARGET=http://localhost:8000
