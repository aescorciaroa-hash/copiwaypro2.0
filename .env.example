APP_ENV=local
APP_DEBUG=true
APP_KEY=changeme_generate_a_random_32_byte_string

# Ruta base de la app bajo el host (ej. /copiwaypro si abres http://localhost/copiwaypro/).
# Vacio = se autodetecta a partir de la ruta real del front controller (recomendado).
APP_BASE_PATH=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hamburguer_copiway
DB_USER=root
DB_PASS=

SESSION_NAME=copiway_session
SESSION_LIFETIME=120

RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15

# Solo para "npm run dev" (Vite): a donde reenviar /api/* mientras desarrollas.
# Por defecto el servidor embebido de PHP (start.bat). Si usas Apache en una
# subcarpeta, cambialo por ejemplo a http://localhost/copiwaypro
VITE_API_PROXY_TARGET=http://localhost:8000
